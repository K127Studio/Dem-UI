{
  "name": "@dem-ui/core",
  "version": "0.3.0",
  "private": true,
  "description": "The whole of Dem UI in one package: foundation, base, functional, content and ui.",
  "author": "K127Studio <K127Studio@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/K127Studio/Dem-UI#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/K127Studio/Dem-UI.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/K127Studio/Dem-UI/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./base": {
      "types": "./dist/base.d.ts",
      "import": "./dist/base.js"
    },
    "./functional": {
      "types": "./dist/functional.d.ts",
      "import": "./dist/functional.js"
    },
    "./content": {
      "types": "./dist/content.d.ts",
      "import": "./dist/content.js"
    },
    "./content/editors": {
      "types": "./dist/content/editors.d.ts",
      "import": "./dist/content/editors.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@dem-ui/foundation": "*",
    "@dem-ui/base": "*",
    "@dem-ui/functional": "*",
    "@dem-ui/content": "*",
    "@dem-ui/ui": "*"
  },
  "devDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
