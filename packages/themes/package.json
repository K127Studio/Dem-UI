{
  "name": "@dem-ui/themes",
  "version": "0.1.0",
  "private": true,
  "description": "Every Dem UI theme in one package.",
  "author": "K127Studio <K127Studio@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/K127Studio/Dem-UI#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/K127Studio/Dem-UI.git",
    "directory": "packages/themes"
  },
  "bugs": {
    "url": "https://github.com/K127Studio/Dem-UI/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "tokens.css",
    "fonts.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./tokens.css",
    "./fonts.css": "./fonts.css"
  },
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "@dem-ui/foundation": "^0.3.0"
  },
  "dependencies": {
    "@dem-ui/theme-base": "*",
    "@dem-ui/theme-neobrutalism": "*",
    "@dem-ui/theme-industrial": "*",
    "@dem-ui/theme-editorial": "*",
    "@dem-ui/theme-glass": "*",
    "@dem-ui/theme-retro": "*"
  },
  "devDependencies": {
    "@dem-ui/foundation": "*"
  }
}
