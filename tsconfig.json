      "@dem-ui/theme-industrial": [
        "./packages/theme-industrial/src/index.ts"
      ],
      "@dem-ui/theme-editorial": [
        "./packages/theme-editorial/src/index.ts"
      ],
      "@dem-ui/theme-glass": [
        "./packages/theme-glass/src/index.ts"
      ],
      "@dem-ui/theme-retro": [
        "./packages/theme-retro/src/index.ts"
      ],
      "@dem-ui/toggle-seventies": [
        "./packages/toggle-seventies/src/index.tsx"
